        },
        {
          "key": "title",
          "type": "text",
          "label": "Card title",
          "required": true,
          "validation": {
            "maxLength": 80
          }
        },
        {
          "key": "description",
          "type": "textarea",
          "label": "Card description",
          "required": true,
          "validation": {
            "maxLength": 300
          }
        },
        {
          "key": "href",
          "type": "url",
          "label": "Card link URL",
          "required": true
