        {
          "key": "features",
          "type": "textarea",
          "label": "Feature bullets",
          "required": false,
          "helpText": "One feature per line.",
          "validation": {
            "maxLength": 400
          }
        },
        {
          "key": "featureKey",
          "type": "select",
          "label": "Plan feature gate",
          "required": true,
          "options": [
            {
              "label": "Text chat",
              "value": "text_chat"
            },
            {
              "label": "Audio chat",
              "value": "audio_chat"
            },
            {
              "label": "Stranger video chat",
              "value": "stranger_video_chat"
            }
          ]
        }
      ],
      "default": [
        {
          "id": "text",
          "title": "Text Chat",
          "description": "Connect with strangers through instant messaging and have fun conversations.",
          "href": "/chat/text",
          "features": "Real-time messaging\nAnonymous\nTyping simulation",
          "featureKey": "text_chat"
        },
        {
          "id": "audio",
          "title": "Audio Chat",
          "description": "Talk with random people using your voice in a simple mock audio room.",
          "href": "/chat/audio",
          "features": "Voice-style UI\nQuick matching\nLightweight mock",
          "featureKey": "audio_chat"
        },
        {
          "id": "video",
          "title": "Video Chat",
          "description": "Use the existing random video + text chat mock interface with strangers.",
          "href": "/chat/video",
          "features": "Video layout\nText side chat\nSkip to next",
          "featureKey": "stranger_video_chat"
        }
      ]
