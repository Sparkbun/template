    {
      "key": "options.items",
      "page": "chat",
      "type": "repeater",
      "label": "Chat hub — chat type cards",
      "required": false,
      "section": "chat.options",
      "itemPresentation": "accordion",
      "helpText": "Card icon and colors are app-defined. featureKey gates visibility by site plan.",
      "validation": {
        "minItems": 0,
        "maxItems": 6
      },
      "itemFields": [
        {
          "key": "id",
          "type": "text",
          "label": "Stable id",
          "required": true,
          "validation": {
            "maxLength": 20
