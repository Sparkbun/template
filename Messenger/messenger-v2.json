{
  "templateId": "messenger",
  "version": 12,
  "name": "Messenger",
  "description": "Landing layouts (classic, centered, split) for /, Cygnus editorial at /landing, plus /chat, /faq, and global site footer. Layouts share landing content fields; Cygnus-specific hero fields override when set.",
  "pages": [
    {
      "key": "landing",
      "route": "/landing",
      "title": "Landing page"
    },
    {
      "key": "chat",
      "route": "/chat",
      "title": "Random chat hub"
    },
    {
      "key": "faq",
      "route": "/faq",
      "title": "FAQ"
    },
    {
      "key": "footer",
      "route": "*",
      "title": "Site footer (global)"
    }
  ],
  "fields": [
    {
      "key": "layout.active",
      "page": "landing",
      "type": "select",
      "label": "Active layout (classic, centered, split)",
      "required": false,
      "default": "classic",
      "section": "layout",
      "helpText": "Layout shown at / for signed-out visitors. Preview: /classic, /centered, /split. /landing always uses the Cygnus editorial layout. All layouts share landing content fields.",
      "options": [
        {
          "label": "Classic",
          "value": "classic"
        },
        {
          "label": "Centered",
          "value": "centered"
        },
        {
          "label": "Split",
          "value": "split"
        }
      ]
    },
    {
      "key": "page.title",
      "page": "chat",
      "type": "text",
      "label": "Chat hub — header title",
      "required": false,
      "default": "Random Chat",
      "section": "chat.header",
      "helpText": "Browser tab title and header heading.",
      "validation": {
        "maxLength": 80
      }
    },
    {
