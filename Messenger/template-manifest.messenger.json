      "default": [
        {
          "category": "Getting Started",
          "id": "gs-1",
          "question": "How do I create an account?",
          "answer": "Visit our login page and click 'Sign Up'. Fill in your email address, create a password, and provide your profile information. You'll receive a confirmation email to verify your account."
        },
        {
          "category": "Getting Started",
          "id": "gs-2",
          "question": "How do I find chat rooms?",
          "answer": "From the home page, you can browse public rooms or use the search feature to find specific topics. You can also join rooms recommended based on your interests."
        },
        {
          "category": "Getting Started",
          "id": "gs-3",
          "question": "What is the difference between public and private rooms?",
          "answer": "Public rooms are open to everyone and appear in search results. Private rooms require an invitation or approval from the room owner to join."
        },
        {
          "category": "Chat Features",
          "id": "cf-1",
          "question": "Can I send files and media in chat rooms?",
          "answer": "Yes, you can share images, videos, documents, and other files in both group chats and direct messages. Simply click the attachment button and select your file."
        },
        {
          "category": "Chat Features",
          "id": "cf-2",
          "question": "How do I pin important messages?",
          "answer": "In any chat room, hover over a message and click the menu icon. Select 'Pin Message' to pin it to the top of the room. Only room moderators can pin/unpin messages."
        },
        {
          "category": "Chat Features",
          "id": "cf-3",
          "question": "What are reactions?",
          "answer": "Reactions let you quickly respond to messages with emojis. Hover over any message and click the emoji icon to add a reaction. This is a non-intrusive way to acknowledge messages."
        },
        {
          "category": "Room Management",
          "id": "rm-1",
          "question": "How do I create my own room?",
          "answer": "Click the 'Create Room' button on the home page. Fill in your room name, description, select privacy settings, and configure optional features like password protection."
        },
        {
          "category": "Room Management",
          "id": "rm-2",
          "question": "How do I manage room members?",
          "answer": "Room owners can access member management through the room settings. You can approve pending members, assign roles, kick users, or ban problematic members."
        },
        {
          "category": "Room Management",
          "id": "rm-3",
          "question": "Can I delete messages in my room?",
          "answer": "Room moderators can delete any message in the room. Regular members can only delete their own messages within a limited time after posting."
        },
        {
          "category": "Privacy & Security",
          "id": "ps-1",
          "question": "Is my chat history encrypted?",
          "answer": "Yes, all messages are encrypted in transit using SSL/TLS encryption. We also encrypt stored data to protect your privacy and security."
        },
        {
          "category": "Privacy & Security",
          "id": "ps-2",
          "question": "Can I block a user?",
          "answer": "Yes, you can block users from their profile or your inbox. Blocked users cannot send you direct messages or see your status."
        },
        {
          "category": "Privacy & Security",
          "id": "ps-3",
          "question": "How do I report inappropriate content?",
          "answer": "Use the report button on any message or user profile. Our moderation team reviews reports and takes appropriate action, including removing content or banning users."
        },
        {
          "category": "Direct Messages & Calls",
          "id": "dm-1",
          "question": "How do I start a direct message with someone?",
          "answer": "Click the 'Inbox' button and start a new conversation, or visit someone's profile and click the message icon. Your conversations are private and only visible to both of you."
        },
        {
          "category": "Direct Messages & Calls",
          "id": "dm-2",
          "question": "Can I make video or audio calls?",
          "answer": "Yes, you can initiate video or audio calls from your inbox or someone's profile. Both users must accept the call request to connect."
        },
        {
          "category": "Direct Messages & Calls",
          "id": "dm-3",
          "question": "What is Random Chat?",
          "answer": "Random Chat connects you with random strangers for 1-to-1 video conversations, similar to Omegle. You can text and video chat with each new connection."
        },
        {
          "category": "Account & Settings",
          "id": "as-1",
          "question": "How do I change my profile picture?",
          "answer": "Go to your profile settings and click on your avatar. Upload a new image from your device. Changes are saved automatically."
        },
        {
          "category": "Account & Settings",
          "id": "as-2",
          "question": "Can I delete my account?",
          "answer": "Yes, you can permanently delete your account from the 'Danger Zone' section in profile settings. This action is irreversible and will remove all your data."
        },
        {
          "category": "Account & Settings",
          "id": "as-3",
          "question": "How do I download my data?",
          "answer": "You can request a backup of your data from the 'Danger Zone' section in profile settings. We'll prepare a file containing all your personal information."
        }
      ]
    },
