      "key": "nav.home.label",
      "page": "navbar",
      "type": "text",
      "label": "Home — label",
      "required": false,
      "default": "Home",
      "section": "navbar.items",
      "validation": { "maxLength": 40 }
    },
    {
      "key": "nav.home.href",
      "page": "navbar",
      "type": "url",
      "label": "Home — URL",
      "required": false,
      "default": "/",
