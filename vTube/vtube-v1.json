{
  "templateId": "vtube",
  "version": 1,
  "name": "vTube",
  "description": "Media watermark for watch player and shorts (top-right).",
  "pages": [
    { "key": "watermark", "route": "*", "title": "Media watermark" }
  ],
  "fields": [
    {
      "key": "watermark.enabled",
      "page": "watermark",
      "type": "boolean",
      "label": "Show watermark",
      "required": false,
      "default": false,
      "section": "watermark",
      "helpText": "Shows on watch player and shorts (top-right)."
    },
    {
      "key": "watermark.mode",
      "page": "watermark",
      "type": "select",
      "label": "Watermark type",
      "required": false,
      "default": "text",
      "section": "watermark",
      "options": [
        { "label": "Text", "value": "text" },
        { "label": "Image", "value": "image" }
      ]
    },
    {
      "key": "watermark.text",
      "page": "watermark",
      "type": "text",
      "label": "Watermark text",
      "required": false,
      "default": "",
      "section": "watermark",
      "visibleIf": { "field": "watermark.mode", "equals": "text" },
      "validation": { "maxLength": 40 }
    },
    {
      "key": "watermark.image",
      "page": "watermark",
      "type": "image",
      "label": "Watermark image",
      "required": false,
      "default": "",
      "section": "watermark",
      "visibleIf": { "field": "watermark.mode", "equals": "image" },
      "helpText": "PNG/SVG with transparent background works best."
    },
    {
      "key": "watermark.opacity",
      "page": "watermark",
      "type": "number",
      "label": "Opacity",
      "required": false,
      "default": 0.75,
      "section": "watermark",
      "helpText": "0.1 – 1.0",
      "validation": { "min": 0.1, "max": 1 }
    }
  ]
}
